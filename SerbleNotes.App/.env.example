# Serble OAuth application id for this client.
VITE_SERBLE_APP_ID=your_serble_app_id_here

# Where the API lives, for builds that are not served by the backend - the desktop and Android apps.
# Leave it unset for the web build: that one is served by the backend and talks to its own origin.
# When it is unset in a native build the app asks for the address on the sign-in screen instead, and
# remembers it on the device, so setting this only saves the user typing it once.
# VITE_API_BASE_URL=https://notes.example.net
