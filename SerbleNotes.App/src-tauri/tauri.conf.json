{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serble Notes",
  "version": "0.1.0",
  "identifier": "net.serble.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serble Notes",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 380,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http: wss: ws:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["serblenotes"]
      },
      "mobile": [{ "scheme": ["serblenotes"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "End-to-end encrypted markdown notes",
    "longDescription": "Markdown notes with full version history, encrypted on your device before they are ever sent anywhere.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
