# .NET
bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/
.idea/

# The web client is built into the backend's wwwroot at publish time; it is never committed.
SerbleNotes.Backend/wwwroot/

# Node
node_modules/
dist/

# Rust
target/

# wasm-pack output - regenerated by `npm run build:core`
SerbleNotes.Core/pkg/

# Local secrets: the Serble app id lives here, .env.example is the committed template. The .local
# pair is Vite's own convention for per-machine overrides.
.env
.env.local
.env.*.local

# Icon sources, regenerated by scripts/make-icon.py from public/icon.svg. The platform icon sets
# they produce are committed; these are just the thing `tauri icon` is pointed at.
SerbleNotes.App/icon-build/

# Publish output: `dotnet publish -c Release -o out` is the documented production build.
/out/

# Signing material and keys, wherever they land. Committing one of these is the mistake that cannot
# be undone by deleting the file afterwards - the history keeps it, and the key has to be replaced.
*.keystore
*.jks
*.p12
*.pfx
*.pem
key.properties
keystore.properties

# Editor and IDE state beyond .idea, which is above.
.vs/
.vscode/
*.user
*.suo
*.swp
*~

# Tool output that regenerates: test runs, Python bytecode from scripts/, logs, incremental caches.
TestResults/
__pycache__/
*.log
npm-debug.log*
*.tsbuildinfo
*.rs.bk

# Files the operating system leaves behind. The zip importer already skips these; so should git.
.DS_Store
Thumbs.db

# Mutation testing. Each tool copies the project somewhere to mutate it, and writes its report
# beside that copy - none of it is source.
.stryker-tmp/
StrykerOutput/
mutants.out/
mutants.out.old/
/SerbleNotes.App/reports/
